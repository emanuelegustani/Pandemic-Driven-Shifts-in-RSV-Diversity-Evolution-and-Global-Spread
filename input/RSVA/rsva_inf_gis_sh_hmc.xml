<!-- Generated by BEAUTi v10.5.0-beta4 Prerelease #unknown                   -->
<!--       by Alexei J. Drummond, Andrew Rambaut and Marc A. Suchard         -->
<!--       Department of Computer Science, University of Auckland and        -->
<!--       Institute of Evolutionary Biology, University of Edinburgh        -->
<!--       David Geffen School of Medicine, University of California, Los Angeles-->
<!--       http://beast.community/                                           -->
<beast version="10.5.0-beta4">
	

	<!-- The list of taxa to be analysed (can also include dates/ages).          -->
	<!-- ntax=1215                                                               -->
	<taxa id="taxa">


	<!-- The sequence alignment (each sequence refers to a taxon above).         -->
	<!-- ntax=1215 nchar=14999                                                   -->
	<alignment id="alignment" dataType="nucleotide">


	<!-- The unique patterns from 1 to end                                       -->
	<!-- npatterns=8343                                                          -->
	<patterns id="patterns" from="1" strip="false">
		<alignment idref="alignment"/>
	</patterns>
	

	<!-- This is a simple constant population size coalescent model              -->
	<!-- that is used to generate an initial tree for the chain.                 -->
	<constantSize id="initialDemo" units="years">
		<populationSize>
			<parameter id="initialDemo.popSize" value="100.0"/>
		</populationSize>
	</constantSize>
	

	<!-- Construct a starting tree that is compatible with specified clade heights-->
	<newick id="startingTree">
		</newick>
	

	<!-- Generate a tree model                                                   -->
	<treeModel id="treeModel">
		<coalescentTree idref="startingTree"/>
		<rootHeight>
			<parameter id="treeModel.rootHeight"/>
		</rootHeight>
		<nodeHeights internalNodes="true">
			<parameter id="treeModel.internalNodeHeights"/>
		</nodeHeights>
		<nodeHeights internalNodes="true" rootNode="true">
			<parameter id="treeModel.allInternalNodeHeights"/>
		</nodeHeights>
	</treeModel>

	<!-- Statistic for height of the root of the tree                            -->
	<treeHeightStatistic id="rootHeight">
		<treeModel idref="treeModel"/>
	</treeHeightStatistic>

	<!-- Statistic for sum of the branch lengths of the tree (tree length)       -->
	<treeLengthStatistic id="treeLength">
		<treeModel idref="treeModel"/>
	</treeLengthStatistic>

	<!-- Statistic for time of most recent common ancestor of tree               -->
	<tmrcaStatistic id="age(root)" absolute="true">
		<treeModel idref="treeModel"/>
	</tmrcaStatistic>
	
	

	<!-- Generate a gmrfSkyGridLikelihood for the Bayesian SkyGrid process       -->
	<gmrfSkyGridLikelihood id="skygrid">
		<populationSizes>

			<!-- skygrid.logPopSize is in log units unlike other popSize                 -->
			<parameter id="skygrid.logPopSize" dimension="42" value="1.0"/>
		</populationSizes>
		<precisionParameter>
			<parameter id="skygrid.precision" value="0.1" lower="0.0"/>
		</precisionParameter>
		<numGridPoints>
			<parameter id="skygrid.numGridPoints" value="41.0"/>
		</numGridPoints>
		<cutOff>
			<parameter id="skygrid.cutOff" value="7.0"/>
		</cutOff>
		<populationTree>
			<treeModel idref="treeModel"/>
		</populationTree>
	</gmrfSkyGridLikelihood>
	<compoundParameter id="skygrid.parameters">
		<parameter idref="skygrid.precision"/>
		<parameter idref="skygrid.logPopSize"/>
	</compoundParameter>

	<gmrfSkyrideGradient id="gmrfGradientPop" wrtParameter="logPopulationSizes">
		<gmrfSkyGridLikelihood idref="skygrid"/>
	</gmrfSkyrideGradient>

	<report>
		<gmrfSkyrideGradient idref="gmrfGradientPop"/>
	</report>

	<gmrfSkyrideGradient id="gmrfGradientPrec" wrtParameter="precision">
		<gmrfSkyGridLikelihood idref="skygrid"/>
	</gmrfSkyrideGradient>

	<report>
		<gmrfSkyrideGradient idref="gmrfGradientPrec"/>
	</report>

	<gammaPrior id="skygrid.precision.prior" shape="0.001" scale="1000" offset="0.0">
		<parameter idref="skygrid.precision"/>
	</gammaPrior>

	<jointGradient id="joint.skygrid.precision">
		<gmrfSkyrideGradient idref="gmrfGradientPrec"/>
		<gradient>
			<gammaPrior idref="skygrid.precision.prior"/>
			<parameter idref="skygrid.precision"/>
		</gradient>
	</jointGradient>

	<compoundGradient id="full.skygrid.gradient">
		<jointGradient idref="joint.skygrid.precision"/>
		<gmrfSkyrideGradient idref="gmrfGradientPop"/>
		<!-- <compoundParameter idref="skygrid.parameters"/> -->
	</compoundGradient>

	<report>
		<compoundGradient idref="full.skygrid.gradient"/>
	</report>

	<gmrfSkyrideGradient id="skyrideGradientWrtNodeHeight" wrtParameter="nodeHeight">
		<gmrfSkyGridLikelihood idref="skygrid"/>
		<treeModel idref="treeModel"/>
	</gmrfSkyrideGradient>

	<!-- The uncorrelated relaxed clock (Drummond, Ho, Phillips & Rambaut (2006) PLoS Biology 4, e88 )-->
	<arbitraryBranchRates id="branchRates" centerAtOne="false">
		<treeModel idref="treeModel"/>
		<rates>
            <parameter id="branchRates.rates" value="1E0" lower="0"/>
        </rates>
        <scale>
            <parameter id="branchRates.scale" lower="0.0" value="1.0"/>
        </scale>
        <location>
            <parameter id="branchRates.location" lower="0.0" value="1E-3"/>
        </location>
	</arbitraryBranchRates>
	
	<rateStatistic id="meanRate" name="meanRate" mode="mean" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<discretizedBranchRates idref="branchRates"/>
	</rateStatistic>
	
	<rateStatistic id="coefficientOfVariation" name="coefficientOfVariation" mode="coefficientOfVariation" internal="true" external="true">
		<treeModel idref="treeModel"/>
		<discretizedBranchRates idref="branchRates"/>
	</rateStatistic>
	
	<rateCovarianceStatistic id="covariance" name="covariance">
		<treeModel idref="treeModel"/>
		<discretizedBranchRates idref="branchRates"/>
	</rateCovarianceStatistic>
	

	<!-- The general time reversible (GTR) substitution model                    -->
	<gtrModel id="gtr">
		<frequencies>
			<frequencyModel dataType="nucleotide">
				<frequencies>
					<parameter id="frequencies" value="0.25 0.25 0.25 0.25"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<rates>
			<parameter id="gtr.rates" dimension="6" value="1.0" lower="0.0"/>
		</rates>
	</gtrModel>

	<!-- site model                                                              -->
	<siteModel id="siteModel">
		<substitutionModel>
			<gtrModel idref="gtr"/>
		</substitutionModel>
		<gammaShape gammaCategories="4">
			<parameter id="alpha" value="0.5" lower="0.0"/>
		</gammaShape>
	</siteModel>

	<!--                                                                         -->
	<statistic id="mu" name="mu">
		<siteModel idref="siteModel"/>
	</statistic>
	

	<!-- Likelihood for tree given sequence data                                 -->
	<treeDataLikelihood id="treeLikelihood" useAmbiguities="false" usePreOrder="true"  scalingScheme="dynamic" delayScaling="true">
		<partition>
			<patterns idref="patterns"/>
			<siteModel idref="siteModel"/>
		</partition>
		<treeModel idref="treeModel"/>
		<discretizedBranchRates idref="branchRates"/>
	</treeDataLikelihood>

    <distributionLikelihood id="ratesPrior">
        <data>
            <parameter idref="branchRates.rates"/>
        </data>
        <distribution>
            <logNormalDistributionModel meanInRealSpace="true">
                <mean>
                    <parameter value="1.0" lower="0.0"/>
                </mean>
                <stdev>
                    <parameter value="1.0" lower="0.0"/>
                </stdev>
            </logNormalDistributionModel>
        </distribution>
    </distributionLikelihood>

	<jointGradient id="jointGradient">
		<hessian>
			<distributionLikelihood idref="ratesPrior"/>
			<parameter idref="branchRates.rates"/>
		</hessian>
		<branchRateGradient id="branchRateGradient" traitName="Sequence">
			<treeDataLikelihood idref="treeLikelihood"/>
		</branchRateGradient>
	</jointGradient>

	<compoundParameter id="locationScale">
		<parameter idref ="branchRates.location"/>
		<parameter idref ="branchRates.scale"/>
	</compoundParameter>

    <distributionLikelihood id="locationScalePrior">
        <data>
            <parameter idref="locationScale"/>
        </data>
        <distribution>
            <exponentialDistributionModel meanInRealSpace="true">
                <mean>
                    <parameter value="1.0" lower="0.0"/>
                </mean>
            </exponentialDistributionModel>
        </distribution>
    </distributionLikelihood>

	<locationScaleGradient id="locationGradient" traitName="Sequence" useHessian="false">
		<treeDataLikelihood idref="treeLikelihood"/>
		<location>
			<parameter idref="branchRates.location"/>
		</location>
	</locationScaleGradient>

	<locationScaleGradient id="scaleGradient" traitName="Sequence" useHessian="false">
		<treeDataLikelihood idref="treeLikelihood"/>
		<scale>
			<parameter idref="branchRates.scale"/>
		</scale>
	</locationScaleGradient>

	<compoundGradient id="locationScaleGradient">
		<locationScaleGradient idref="locationGradient"/>
		<locationScaleGradient idref="scaleGradient"/>
	</compoundGradient>

	<jointGradient id="locationScaleJointGradient">
		<hessian>
			<distributionLikelihood idref="locationScalePrior"/>
			<parameter idref="locationScale"/>
		</hessian>
		<compoundGradient idref="locationScaleGradient"/>
	</jointGradient>

	<jointGradient id="jointNodeHeightGradient">
		<gmrfSkyrideGradient idref="skyrideGradientWrtNodeHeight"/>
		<nodeHeightGradient id="nodeHeightGradient" traitName="Sequence">
			<treeDataLikelihood idref="treeLikelihood"/>
		</nodeHeightGradient>
	</jointGradient>

 	<nodeHeightTransform id="logitRatioTransform" withRoot="false">
		<tree idref="treeModel"/>
		<arbitraryBranchRates idref="branchRates"/>
		<ratios realLine="true">
			<parameter id="nodeHeight.ratios"/>
		</ratios>
	</nodeHeightTransform>

	<nodeHeightProxyParameter id="nodeHeightProxyParameter" rootNode="false">
		<tree idref="treeModel"/>
	</nodeHeightProxyParameter>	

	<nodeHeightTransform id="fullRatioRealLineTransform" withRoot="true">
		<tree idref="treeModel"/>
		<arbitraryBranchRates idref="branchRates"/>
		<ratios realLine="true">
			<parameter idref="nodeHeight.ratios"/>
		</ratios>
	</nodeHeightTransform>

	<nodeHeightProxyParameter id="nodeHeightProxyWithRootParameter" rootNode="true">
		<tree idref="treeModel"/>
	</nodeHeightProxyParameter>


<!--     <maximizeWrtParameter id="maximizeWrtHeights" startAtCurrentState = "true" printToScreen="true"  nIterations="10">
		<jointGradient idref="jointNodeHeightGradient"/>
		<nodeHeightTransform idref="fullRatioRealLineTransform"/>
    </maximizeWrtParameter>

    <report>
        <maximizeWrtParameterParser idref="maximizeWrtHeights"/>
    </report> -->

	<multivariateCompoundTransform id="rateNTimeTransform">
		<signTransform id="rateTransform">
			<parameter idref ="branchRates.rates"/>
		</signTransform>
		<nodeHeightTransform idref="fullRatioRealLineTransform"/>
	</multivariateCompoundTransform>

	<compoundGradient id="rateNTimeGradient">
		<jointGradient idref="jointGradient"/>
		<jointGradient idref="jointNodeHeightGradient"/>
	</compoundGradient>

	<compoundParameter id="rateNTimeParameter">
		<parameter idref="branchRates.rates"/>
		<nodeHeightProxyParameter idref="nodeHeightProxyWithRootParameter"/>
	</compoundParameter>
	

	<!-- Define operators                                                        -->
	<operators id="operators" optimizationSchedule="log">
		<hamiltonianMonteCarloOperator weight="1" nSteps="4" stepSize="1E-2" mode="vanilla" instabilityHandler="reject"
                                       drawVariance="1.0" autoOptimize="true"
                                       preconditioning="diagonal" preconditioningDelay="0" preconditioningUpdateFrequency="10"
                                       gradientCheckCount="10" gradientCheckTolerance="5E+1">
            <jointGradient idref="jointGradient"/>
            <parameter idref ="branchRates.rates"/>
            <signTransform>
                <parameter idref ="branchRates.rates"/>
            </signTransform>
        </hamiltonianMonteCarloOperator>

		<deltaExchange delta="0.01" weight="1">
			<parameter idref="gtr.rates"/>
		</deltaExchange>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="frequencies"/>
		</deltaExchange>
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="alpha"/>
		</scaleOperator>
	
		<scaleOperator scaleFactor="0.75" weight="5">
			<parameter idref="branchRates.scale"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="15">
			<parameter idref="branchRates.location"/>
		</scaleOperator>

		<upDownOperator scaleFactor="0.75" weight="10">
			<up>
				<parameter idref="treeModel.allInternalNodeHeights"/>
			</up>
			<down>
				<parameter idref="branchRates.location"/>
			</down>
		</upDownOperator>

		<subtreeLeap size="1.0" weight="1000">
			<treeModel idref="treeModel"/>
		</subtreeLeap>
		<fixedHeightSubtreePruneRegraft weight="100">
			<treeModel idref="treeModel"/>
		</fixedHeightSubtreePruneRegraft>
		<hamiltonianMonteCarloOperator weight="1" nSteps="4" stepSize="7.8E-2" mode="vanilla" instabilityHandler="reject"
									   drawVariance="1.0" autoOptimize="true" targetAcceptanceProbability="0.2"
									   preconditioning="adaptiveDiagonal" preconditioningDelay="200" preconditioningUpdateFrequency="10">
			<jointGradient idref="jointNodeHeightGradient"/>
			<nodeHeightProxyParameter idref="nodeHeightProxyParameter"/>
			<nodeHeightTransform idref="logitRatioTransform"/>
		</hamiltonianMonteCarloOperator>

		<hamiltonianMonteCarloOperator weight="1" nSteps="4" stepSize="7.8E-3" mode="vanilla" instabilityHandler="reject"
									   drawVariance="1.0" autoOptimize="true" targetAcceptanceProbability="0.2"
									   preconditioning="adaptiveDiagonal" preconditioningDelay="200" preconditioningUpdateFrequency="10">
			<jointGradient idref="jointNodeHeightGradient"/>
			<nodeHeightProxyParameter idref="nodeHeightProxyWithRootParameter"/>
			<nodeHeightTransform idref="fullRatioRealLineTransform"/>
		</hamiltonianMonteCarloOperator>


<!-- 
		<hamiltonianMonteCarloOperator weight="10" nSteps="4" stepSize="7.8E-4" mode="vanilla" instabilityHandler="reject"
									   drawVariance="1.0" autoOptimize="true" targetAcceptanceProbability="0.2"
									   preconditioning="adaptiveDiagonal" preconditioningDelay="200" preconditioningUpdateFrequency="10">
			<compoundGradient idref="rateNTimeGradient"/>
			<compoundParameter idref="rateNTimeParameter"/>
			<multivariateCompoundTransform idref="rateNTimeTransform"/>
		</hamiltonianMonteCarloOperator>

		<hamiltonianMonteCarloOperator weight="10" nSteps="4" stepSize="7.8E-4" mode="vanilla" instabilityHandler="reject"
									   drawVariance="1.0" autoOptimize="true" targetAcceptanceProbability="0.6"
									   preconditioning="adaptiveDiagonal" preconditioningDelay="200" preconditioningUpdateFrequency="10">
			<compoundGradient idref="rateNTimeGradient"/>
			<compoundParameter idref="rateNTimeParameter"/>
			<multivariateCompoundTransform idref="rateNTimeTransform"/>
		</hamiltonianMonteCarloOperator>
 -->

		<gmrfGridBlockUpdateOperator scaleFactor="1.0" weight="2">
			<gmrfSkyrideLikelihood idref="skygrid"/>
		</gmrfGridBlockUpdateOperator>
		<scaleOperator scaleFactor="0.75" weight="1">
			<parameter idref="skygrid.precision"/>
		</scaleOperator>
		<hamiltonianMonteCarloOperator weight="15" nSteps="10" stepSize="1E-3"
			mode="vanilla" autoOptimize="true"
			gradientCheckCount="0"
			gradientCheckTolerance="5E+1"
						preconditioning="diagonal"
			preconditioningUpdateFrequency="100"
			>
	 		<compoundGradient idref="full.skygrid.gradient"/>
			<compoundParameter idref="skygrid.parameters"/>
			<signTransform start="1" end="1">
				<compoundParameter idref="skygrid.parameters"/>
			</signTransform>
		</hamiltonianMonteCarloOperator>
	</operators>

	<!-- Define MCMC                                                             -->
	<mcmc id="mcmc" chainLength="100000000" autoOptimize="true" operatorAnalysis="rsv_a_sh_hmc.ops">
		<joint id="joint">
			<prior id="prior">
				<dirichletPrior alpha="1.0" sumsTo="6.0">
					<parameter idref="gtr.rates"/>
				</dirichletPrior>
				<dirichletPrior alpha="1.0" sumsTo="1.0">
					<parameter idref="frequencies"/>
				</dirichletPrior>
				<exponentialPrior mean="0.5" offset="0.0">
					<parameter idref="alpha"/>
				</exponentialPrior>
				<ctmcScalePrior>
					<ctmcScale>
						<parameter idref="branchRates.location"/>
					</ctmcScale>
					<treeModel idref="treeModel"/>
				</ctmcScalePrior>
				<exponentialPrior mean="0.3333333333333333" offset="0.0">
					<parameter idref="branchRates.scale"/>
				</exponentialPrior>
				<distributionLikelihood idref="ratesPrior"/>
				<gammaPrior idref="skygrid.precision.prior"/>
				
				<gmrfSkyGridLikelihood idref="skygrid"/>
				
				<discretizedBranchRates idref="branchRates"/>
			</prior>
			<likelihood id="likelihood">
				<treeDataLikelihood idref="treeLikelihood"/>
			</likelihood>
		</joint>
		<operators idref="operators"/>

		<!-- write log to screen                                                     -->
		<log id="screenLog" logEvery="20000">
			<column label="Joint" dp="4" width="12">
				<joint idref="joint"/>
			</column>
			<column label="Prior" dp="4" width="12">
				<prior idref="prior"/>
			</column>
			<column label="Likelihood" dp="4" width="12">
				<likelihood idref="likelihood"/>
			</column>
			<column label="age(root)" sf="6" width="12">
				<tmrcaStatistic idref="age(root)"/>
			</column>
			<column label="branchRates.location" sf="6" width="12">
				<parameter idref="branchRates.location"/>
			</column>
			<column label="branchRates.scale" sf="6" width="12">
				<parameter idref="branchRates.scale"/>
			</column>
		</log>

		<!-- write log to file                                                       -->
		<log id="fileLog" logEvery="20000" fileName="rsv_a_sh_hmc.log" overwrite="false">
			<joint idref="joint"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<treeHeightStatistic idref="rootHeight"/>
			<tmrcaStatistic idref="age(root)"/>
			<treeLengthStatistic idref="treeLength"/>
			<parameter idref="skygrid.precision"/>
			<parameter idref="skygrid.logPopSize"/>
			<parameter idref="skygrid.cutOff"/>
			<parameter idref="gtr.rates"/>
			<parameter idref="frequencies"/>
			<parameter idref="alpha"/>
			<parameter idref ="branchRates.location"/>
			<parameter idref ="branchRates.scale"/>
			<rateStatistic idref="coefficientOfVariation"/>
			<rateCovarianceStatistic idref="covariance"/>
			<treeDataLikelihood idref="treeLikelihood"/>
			<discretizedBranchRates idref="branchRates"/>
			<gmrfSkyGridLikelihood idref="skygrid"/>
		</log>

		<!-- write tree log to file                                                  -->
		<logTree id="treeFileLog" logEvery="20000" nexusFormat="true" fileName="rsv_a_sh_hmc.trees" sortTranslationTable="true">
			<treeModel idref="treeModel"/>
			<trait name="rate" tag="rate">
				<discretizedBranchRates idref="branchRates"/>
			</trait>
			<joint idref="joint"/>
		</logTree>

		<!-- write state of Markov chain to checkpoint file                          -->
		<logCheckpoint id="checkpointFileLog" checkpointEvery="1000000" checkpointFinal="100000000" fileName="rsv_a_sh_hmc.chkpt" overwrite="false"/>
	</mcmc>
	
	<report>
		<property name="timer">
			<mcmc idref="mcmc"/>
		</property>
	</report>
	
</beast>
